@model DriveHub.Web.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Главная";
}

<!-- ГЛАВНЫЙ БЛОК -->
<section class="dh-hero">
    <h1>Найдите свой автомобиль</h1>
    <p>Каталог новых и подержанных автомобилей, заявки на тест-драйв и покупку онлайн.</p>
    <a class="btn btn-light-dh btn-lg" asp-controller="Catalog" asp-action="Index">Смотреть каталог</a>
</section>

<!-- БЫСТРЫЙ ПОИСК: отправляет выбранные значения в каталог (метод GET) -->
<form method="get" asp-controller="Catalog" asp-action="Index" class="dh-search">
    <div class="row g-3">
        <div class="col-md-3">
            <select name="BrandId" class="form-select" aria-label="Марка">
                <option value="">Все марки</option>
                @foreach (var b in Model.Brands)
                {
                    <option value="@b.BrandId">@b.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3"><input type="number" name="MaxPrice" min="0" step="10000" class="form-control" placeholder="Цена до, ₽" /></div>
        <div class="col-md-3"><input type="number" name="MinYear" min="1990" max="2030" class="form-control" placeholder="Год от" /></div>
        <div class="col-md-3 d-grid"><button class="btn btn-primary" type="submit">Найти</button></div>
    </div>
</form>

<!-- НОВЫЕ ПОСТУПЛЕНИЯ: реальные автомобили из базы -->
<h2 class="dh-section">Новые поступления</h2>
<div class="row g-4">
    @foreach (var car in Model.Latest)
    {
        <div class="col-md-4">
            <div class="dh-card">
                @if (!string.IsNullOrEmpty(car.PhotoPath))
                {
                    <img src="@car.PhotoPath" alt="@car.Model!.Brand!.Name @car.Model.Name" class="dh-photo-img" />
                }
                else
                {
                    <div class="dh-photo">Фото</div>
                }
                <div class="dh-card-body">
                    <h5 class="mb-1">@car.Model!.Brand!.Name @car.Model.Name</h5>
                    <div class="dh-specs mb-3">
                        @car.ManufactureYear · @(car.Mileage == 0 ? "новый" : car.Mileage.ToString("N0") + " км") · @car.Transmission
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="dh-price">@car.Price.ToString("N0") ₽</span>
                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@car.CarId" class="btn btn-primary btn-sm">Подробнее</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<div class="text-center mt-4">
    <a asp-controller="Catalog" asp-action="Index" class="btn btn-light-dh">Весь каталог</a>
</div>

<!-- КАК ЭТО РАБОТАЕТ -->
<h2 class="dh-section">Как это работает</h2>
<div class="row g-4">
    <div class="col-md-4"><div class="dh-step"><div class="dh-step-num">1</div><h5>Выберите автомобиль</h5><p class="dh-specs mb-0">Используйте фильтры по марке, цене и году.</p></div></div>
    <div class="col-md-4"><div class="dh-step"><div class="dh-step-num">2</div><h5>Оставьте заявку</h5><p class="dh-specs mb-0">Запишитесь на тест-драйв или подайте заявку на покупку.</p></div></div>
    <div class="col-md-4"><div class="dh-step"><div class="dh-step-num">3</div><h5>Оформите сделку</h5><p class="dh-specs mb-0">Менеджер одобрит заявку и подготовит договор.</p></div></div>
</div>