@model DriveHub.Web.ViewModels.CatalogViewModel
@{
    ViewData["Title"] = "Каталог";
    var f = Model.Filter; // текущие значения фильтра
}

<h1 class="dh-section" style="margin-top:2rem">Каталог автомобилей</h1>

<!-- ФИЛЬТРЫ: форма отправляется методом GET, значения попадают в адресную строку -->
<form method="get" asp-action="Index" class="dh-search mb-4" style="margin-top:0">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Марка</label>
            <select name="BrandId" class="form-select">
                <option value="">Все марки</option>
                @foreach (var b in Model.Brands)
                {
                    <option value="@b.BrandId" selected="@(f.BrandId == b.BrandId)">@b.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Цена до, ₽</label>
            <input type="number" name="MaxPrice" min="0" step="10000" value="@f.MaxPrice" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Год от</label>
            <input type="number" name="MinYear" min="1990" max="2030" value="@f.MinYear" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Сортировка</label>
            <select name="Sort" class="form-select">
                <option value="new" selected="@(f.Sort == "new")">Сначала новые поступления</option>
                <option value="price_asc" selected="@(f.Sort == "price_asc")">Цена: по возрастанию</option>
                <option value="price_desc" selected="@(f.Sort == "price_desc")">Цена: по убыванию</option>
                <option value="year_desc" selected="@(f.Sort == "year_desc")">Год: сначала новые</option>
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-primary" type="submit">Найти</button>
        </div>
    </div>
</form>

<p class="dh-specs">Найдено автомобилей: @Model.Total</p>

<!-- СПИСОК КАРТОЧЕК -->
@if (Model.Cars.Count == 0)
{
    <div class="dh-step">По вашему запросу ничего не найдено. Попробуйте изменить фильтры.</div>
}
else
{
    <div class="row g-4">
        @foreach (var car in Model.Cars)
        {
            <div class="col-md-6 col-lg-4">
                <div class="dh-card">
                    <!-- Фото: если файла нет, показываем заглушку -->
                    @if (!string.IsNullOrEmpty(car.PhotoPath))
                    {
                        <img src="@car.PhotoPath" alt="@car.Model!.Brand!.Name @car.Model.Name" class="dh-photo-img" />
                    }
                    else
                    {
                        <div class="dh-photo">Фото</div>
                    }
                    <div class="dh-card-body">
                        <h5 class="mb-1">@car.Model!.Brand!.Name @car.Model.Name</h5>
                        <div class="dh-specs mb-2">
                            @car.ManufactureYear · @(car.Mileage == 0 ? "новый" : car.Mileage.ToString("N0") + " км") · @car.Transmission
                        </div>
                        @if (car.Status == DriveHub.Web.Domain.Enums.CarStatus.Reserved)
                        {
                            <span class="dh-badge">Зарезервирован</span>
                        }
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="dh-price">@car.Price.ToString("N0") ₽</span>
                            <a asp-action="Details" asp-route-id="@car.CarId" class="btn btn-primary btn-sm">Подробнее</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- ПОСТРАНИЧНАЯ НАВИГАЦИЯ (показываем, только если страниц больше одной) -->
@if (Model.Pages > 1)
{
    <nav class="mt-4" aria-label="Страницы каталога">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.Pages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-BrandId="@f.BrandId" asp-route-MaxPrice="@f.MaxPrice"
                       asp-route-MinYear="@f.MinYear" asp-route-Sort="@f.Sort"
                       asp-route-Page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}